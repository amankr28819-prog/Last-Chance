# Environment Variable Template for Last Chance
# Copy this file to .env and configure your production values

# Server Host & Port
HOST=0.0.0.0
PORT=8000

# Database Configuration
# Leave unset or empty for default local SQLite (data/lastchance.db)
# Or provide PostgreSQL URI for persistent multi-device deployment:
# DATABASE_URL=postgresql://username:password@host:5432/database_name
DATABASE_URL=

# Authentication Secret (Used for signing HMAC-SHA256 JWT sessions)
# Generate a secure 64-character random string in production
JWT_SECRET_KEY=change_this_to_a_secure_random_secret_in_production

# Application Settings
DEFAULT_THEME=dark
ENABLE_RELOAD=false

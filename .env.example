# ==============================================================================
# Last Chance — Environment Configuration Template
# Copy this file to .env and configure with your production credentials.
# NEVER commit the real .env file or real secrets to source control.
# ==============================================================================

# Server Network Configuration (Render automatically injects PORT)
HOST=0.0.0.0
PORT=8000

# ----------------- DATABASE CONFIGURATION -----------------
# For Local Development (Default):
# Leave DATABASE_URL blank or unset to use the local SQLite database (data/lastchance.db).
#
# For Supabase PostgreSQL (Production / Multi-device):
# Get this from Supabase Dashboard -> Project Settings -> Database -> Connection String (URI).
# Example: postgresql://postgres.[PROJECT_REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
DATABASE_URL=

# ----------------- SUPABASE STORAGE (Handouts & Documents) -----------------
# Get these from Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
# Use your service_role key for backend operations, or anon key for public operations
SUPABASE_KEY=your-supabase-service-role-or-anon-key-here
# Bucket name in Supabase Storage (Default: handouts)
SUPABASE_STORAGE_BUCKET=handouts

# ----------------- AUTHENTICATION & SECURITY -----------------
# 64-character secret key used for cryptographically signing JWT authentication tokens
# Generate using: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change_this_to_a_secure_random_64_character_hex_secret_in_production

# ----------------- CORS CONFIGURATION (Frontend Access) -----------------
# Comma-separated list of allowed frontend origins (e.g. Vercel deployment URL)
# Example: https://last-chance.vercel.app,http://localhost:3000,http://localhost:8000
CORS_ORIGINS=*

# ----------------- APPLICATION PREFERENCES -----------------
DEFAULT_THEME=dark
ENABLE_RELOAD=false
